{
  "name": "guardian-bay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --host=127.0.0.1",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:security": "npm test && npm run test:integration && npm run build && npm run test:security:http",
    "test:watch": "vitest",
    "verify": "npm run check && npm run build",
    "pretest:integration": "node scripts/test-environment.mjs integration",
    "pretest:security": "node scripts/test-environment.mjs browser",
    "pretest:security:http": "node scripts/test-environment.mjs browser",
    "test:security:http": "node --test --test-concurrency=1 scripts/security-browser.test.mjs scripts/security-actions.test.mjs",
    "ci": "npm run check && npm run test:integration && npm run build && npm run test:security:http",
    "db:check": "node scripts/check-migrations.mjs",
    "security:dependencies": "node scripts/check-dependencies.mjs",
    "security:setup": "node --use-env-proxy scripts/install-security-tools.mjs && python3 -m venv .vitest/tools/semgrep-venv && .vitest/tools/semgrep-venv/bin/python -m pip install -r .github/security/requirements.txt",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:sast": "node scripts/check-sast.mjs",
    "ci:validate": ".vitest/tools/actionlint -color",
    "ci:integrity": "node scripts/check-integrity.mjs",
    "test:integration:local": "node --env-file=.env.test.local scripts/test-integration-local.mjs",
    "media:cleanup": "node scripts/media-cleanup.mjs",
    "seeder:products": "node scripts/seeder-products.mjs",
    "test:scripts": "node --test scripts/seeder/*.test.mjs scripts/system/*.test.mjs",
    "system:init": "node scripts/system-init.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-toast": "1.2.24",
    "@tanstack/react-query": "5.104.5",
    "argon2": "0.45.1",
    "dinero.js": "2.0.2",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.52.0",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@next/env": "16.4.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
