{
  "name": "guardian-bay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --host=127.0.0.1",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:security": "npm test && npm run test:integration && npm run build && node --test --test-concurrency=1 scripts/security-browser.test.mjs scripts/security-actions.test.mjs",
    "test:watch": "vitest",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.24",
    "argon2": "0.45.1",
    "dinero.js": "2.0.2",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@next/env": "16.3.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
