# DATABASE_URL é obrigatória para operações de banco e comandos Drizzle Kit.
# Quando necessário, configure valores locais em .env.local na raiz.
# Nunca coloque secrets neste exemplo ou em variáveis NEXT_PUBLIC_*.

# Server-only
# Não é necessária para rotas sem acesso ao banco.
# Formato fictício: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
# Opcional, server-only: conexões por processo, inteiro de1a10. Padrão10.
# Dimensionar somando todos os processos e clientes auxiliares.
# DATABASE_POOL_MAX=10

# Testes de integração: banco exclusivo local chamado guardian_bay_test.
# Nunca usa DATABASE_URL como fallback; configure apenas ao executar integração.
# Alternativa local: defina em .env.test.local e use npm run test:integration:local.
TEST_DATABASE_URL=

# Server-only: CPF encryption. Generate a random 32-byte base64 key outside Git.
# Set these in ignored .env.local and independently in .env.test.local.
# Keep previous keys in the keyring when changing the active ID.
# BUYER_DATA_ACTIVE_KEY_ID=local-v1
# BUYER_DATA_KEYS='{"local-v1":"BASE64_32_BYTE_KEY"}'

# Public
# Nenhuma variável pública necessária atualmente.

# Diretório absoluto persistente de imagens, fora de public/src/.next.
# PRODUCT_MEDIA_DIR=/var/lib/guardian-bay/media
# Marcação explícita para operações CLI locais (seed/limpeza); nunca em produção pública.
# GUARDIAN_LOCAL_DEMO=1

# Operação de migration apenas, em arquivo privado separado do runtime:
# MIGRATION_DATABASE_URL=
